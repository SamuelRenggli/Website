---
import Photo from './Photo.astro';
import { ui, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].about;
---

<section class="about section" id="ueber-mich" aria-labelledby="about-title">
  <div class="wrap grid">
    <figure class="portrait">
      <Photo slug="manu-portrait" alt={t.portraitAlt} sizes="(max-width: 760px) 100vw, 45vw" />
    </figure>
    <div class="text">
      <h2 id="about-title">{t.title}</h2>
      <p class="lede">{t.lede}</p>
      {t.paragraphs.map((p) => <p>{p}</p>)}
      <a class="btn btn-quiet" href={`${localePath(lang)}#kontakt`}>{ui[lang].cta}</a>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    align-items: start;
  }
  figure {
    margin: 0;
  }
  .portrait {
    grid-column: 1 / span 5;
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
  }
  .text {
    grid-column: 7 / span 6;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-top: clamp(0rem, 4vw, 3rem);
  }
  .text > p:not(.lede) {
    max-width: 62ch;
  }
  @media (max-width: 760px) {
    .portrait,
    .text {
      grid-column: 1 / -1;
    }
  }
</style>
