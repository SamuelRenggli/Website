---
import Photo from './Photo.astro';
import { ui, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].about;
---

<section class="about section" id="ueber-mich" aria-labelledby="about-title">
  <div class="wrap grid">
    <figure class="portrait">
      <Photo slug="manu-portrait" alt={t.portraitAlt} sizes="(max-width: 760px) 100vw, 45vw" />
    </figure>
    <div class="text">
      <h2 id="about-title">{t.title}</h2>
      <p class="lede">{t.lede}</p>
      <p>{t.p1}</p>
      <p>{t.p2}</p>
      <dl class="facts">
        {
          t.facts.map(([term, value]) => (
            <div>
              <dt>{term}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      <a class="btn btn-quiet" href={`${localePath(lang)}#kontakt`}>{ui[lang].cta}</a>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gutter);
    align-items: start;
  }
  figure {
    margin: 0;
  }
  .portrait {
    grid-column: 1 / span 5;
  }
  .portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
  }
  .text {
    grid-column: 7 / span 6;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-top: clamp(0rem, 4vw, 3rem);
  }
  .text > p:not(.lede) {
    max-width: 62ch;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    width: 100%;
    margin: 0.5rem 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
    font-size: var(--step--1);
  }
  dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
    line-height: 1.35;
  }
  @media (max-width: 760px) {
    .portrait,
    .text {
      grid-column: 1 / -1;
    }
    .facts {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
