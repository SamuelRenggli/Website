---
import Icon from './Icon.astro';
import { site } from '../config';
import { ui, localePath, switchPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  overlay?: boolean;
}
const { lang, overlay = false } = Astro.props;
const t = ui[lang];
const home = localePath(lang);
const links = [
  { href: `${home}#angebot`, label: t.nav.offers },
  { href: `${home}#ueber-mich`, label: t.nav.about },
  { href: `${home}#filme`, label: t.nav.clips },
  { href: `${home}#galerie`, label: t.nav.gallery },
];
const otherLang = lang === 'de' ? 'en' : 'de';
const otherHref = switchPath(lang, Astro.url.pathname);
---

<header class="header" data-overlay={overlay ? '' : undefined} data-header>
  <div class="bar wrap">
    <a class="brand" href={home}>{site.name}<span class="role">{t.role}</span></a>
    <nav aria-label={t.navLabel}>
      <ul class="links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <a class="lang" href={otherHref} hreflang={otherLang} lang={otherLang} aria-label={t.switchLabel}>
      {otherLang.toUpperCase()}
    </a>
    <a class="btn btn-primary cta" href={`${home}#kontakt`}>{t.cta}</a>
    <button
      class="menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-btn
      data-open-label={t.menuOpen}
      data-close-label={t.menuClose}
    >
      <Icon name="list" />
      <span class="visually-hidden">{t.menuOpen}</span>
    </button>
  </div>
  <div class="sheet" id="mobile-menu" hidden data-menu>
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <a class="btn btn-primary" href={`${home}#kontakt`}>{t.cta}</a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;

  // Solid background once the page is scrolled past the top
  const onScroll = () => header.toggleAttribute('data-solid', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('.visually-hidden')!.textContent = open ? btn.dataset.closeLabel! : btn.dataset.openLabel!;
    menu.hidden = !open;
    header.toggleAttribute('data-open', open);
  };
  btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      btn.focus();
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--text);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    transition:
      background-color 240ms ease,
      color 240ms ease,
      box-shadow 240ms ease;
  }
  /* Over the hero video: transparent with white text until scrolled */
  .header[data-overlay] {
    position: fixed;
    inset: 0 0 auto;
  }
  .header[data-overlay]:not([data-solid], [data-open]) {
    background: transparent;
    backdrop-filter: none;
    color: #fff;
  }
  .header[data-solid] {
    box-shadow: 0 1px 0 var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 4.25rem;
  }
  .brand {
    margin-right: auto;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .role {
    margin-left: 0.6rem;
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    opacity: 0.8;
  }
  @media (max-width: 420px) {
    .role {
      display: none;
    }
  }
  .links {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    font-weight: 500;
    text-decoration: none;
  }
  .links a:hover,
  .lang:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }
  .lang {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    margin-inline: -0.75rem;
    font-weight: 600;
    text-decoration: none;
  }
  .cta {
    min-height: 2.75rem;
    padding-block: 0.6rem;
  }
  .menu-btn {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: var(--pill);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .menu-btn :global(.icon) {
    width: 1.75rem;
    height: 1.75rem;
  }
  .sheet {
    padding: 0.5rem var(--gutter) 2rem;
    border-top: 1px solid var(--line);
  }
  .sheet ul {
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }
  .sheet li a {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-3);
    text-transform: uppercase;
    text-decoration: none;
  }
  .role {
    margin-left: 0.6rem;
    font-family: var(--font);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    opacity: 0.8;
  }
  @media (max-width: 420px) {
    .role {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .bar {
      gap: 1.25rem;
    }
    .links,
    .cta {
      display: none;
    }
    .menu-btn {
      display: grid;
    }
  }
  @media (min-width: 861px) {
    .sheet {
      display: none;
    }
  }
</style>
