---
import Icon from './Icon.astro';
import { site, url } from '../config';
import { ui, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const home = localePath(lang);

// Each source has a winter and a summer file; the summer film has no 1440 size
const sources = [
  { media: '(max-width: 900px) and (orientation: portrait)', winter: 'mobile', summer: 'mobile' },
  { media: '(max-width: 900px)', winter: '720', summer: '720' },
  { media: '(max-width: 1600px)', winter: '1080', summer: '1080' },
  { media: undefined, winter: '1440', summer: '1080' },
];
const seasons = [
  { id: 'winter', label: t.offers.winter, icon: 'snowflake' },
  { id: 'summer', label: t.offers.summer, icon: 'sun' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <video
    class="media"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={url('media/hero-winter-poster.jpg')}
    aria-hidden="true"
    data-hero-video
    data-poster-winter={url('media/hero-winter-poster.jpg')}
    data-poster-summer={url('media/hero-summer-poster.jpg')}
  >
    {
      sources.map((s) => (
        <source
          src={url(`media/hero-winter-${s.winter}.mp4`)}
          type="video/mp4"
          media={s.media}
          data-winter={url(`media/hero-winter-${s.winter}.mp4`)}
          data-summer={url(`media/hero-summer-${s.summer}.mp4`)}
        />
      ))
    }
  </video>
  <script is:inline>
    // Runs while the page is parsed, before the video picks a file: summer film from May to October
    (() => {
      const m = new Date().getMonth();
      const season = m >= 4 && m <= 9 ? 'summer' : 'winter';
      document.documentElement.dataset.season = season;
      const video = document.querySelector('[data-hero-video]');
      video.poster = video.dataset['poster' + (season === 'summer' ? 'Summer' : 'Winter')];
      for (const s of video.querySelectorAll('source')) s.src = s.dataset[season];
    })();
  </script>
  <div class="scrim"></div>

  <div class="content wrap">
    <h1 id="hero-title" class="visually-hidden">{site.person}</h1>
    <p class="sub">{t.hero.sub}</p>
    <div class="actions">
      <a class="btn btn-primary" href={`${home}#kontakt`}>{t.cta}</a>
      <a class="btn btn-quiet" href={`${home}#angebot`}>{t.hero.secondary}</a>
    </div>
  </div>

  <div class="season" role="group" aria-label={t.offers.seasonLabel} data-season-switch>
    {
      seasons.map((s) => (
        <button type="button" aria-pressed={s.id === 'winter' ? 'true' : 'false'} data-season={s.id}>
          <Icon name={s.icon} />
          {s.label}
        </button>
      ))
    }
  </div>

  <button
    class="pause"
    type="button"
    aria-pressed="false"
    data-hero-pause
    data-pause-label={t.hero.pause}
    data-play-label={t.hero.play}
  >
    <span data-icon-pause><Icon name="pause" /></span>
    <span data-icon-play hidden><Icon name="play" /></span>
    <span class="visually-hidden">{t.hero.pause}</span>
  </button>
</section>

<script>
  import { getSeason, setSeason, onSeason, type Season } from '../season';

  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-hero-pause]')!;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Paused on purpose (button or reduced-motion setting): never restart on our own
  let held = reduce.matches;

  // The button always shows the real state of the video
  const show = (paused: boolean) => {
    btn.setAttribute('aria-pressed', String(paused));
    btn.querySelector('[data-icon-pause]')!.toggleAttribute('hidden', paused);
    btn.querySelector('[data-icon-play]')!.toggleAttribute('hidden', !paused);
    btn.querySelector('.visually-hidden')!.textContent = paused ? btn.dataset.playLabel! : btn.dataset.pauseLabel!;
  };
  video.addEventListener('play', () => show(false));
  video.addEventListener('pause', () => show(true));

  const start = () => (held ? Promise.resolve() : video.play());

  if (held) video.pause();
  else
    start().catch(() => {
      // Autoplay blocked (e.g. iPhone Low Power Mode, Android Data Saver): start on the first tap
      const retry = () => start().catch(() => {});
      for (const e of ['touchend', 'click', 'keydown']) window.addEventListener(e, retry, { once: true, passive: true });
      show(true);
    });

  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    held = !video.paused;
    if (held) video.pause();
    else video.play().catch(() => {});
  });

  // Season switch: swap the film, keep playing unless paused on purpose
  const seasonBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-season-switch] button')];
  const showSeason = (season: Season) => {
    for (const b of seasonBtns) b.setAttribute('aria-pressed', String(b.dataset.season === season));
  };
  showSeason(getSeason());
  for (const b of seasonBtns) b.addEventListener('click', () => setSeason(b.dataset.season as Season));
  onSeason((season) => {
    showSeason(season);
    video.poster = season === 'summer' ? video.dataset.posterSummer! : video.dataset.posterWinter!;
    for (const s of video.querySelectorAll('source')) s.src = s.dataset[season]!;
    video.autoplay = false;
    video.load();
    if (!held) video.play().catch(() => {});
  });
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    overflow: hidden;
    color: #fff;
    background: var(--ink);
  }
  .media,
  .scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .media {
    object-fit: cover;
  }
  .scrim {
    background:
      linear-gradient(to top, rgb(15 38 56 / 0.78) 0%, rgb(15 38 56 / 0.25) 45%, transparent 70%),
      linear-gradient(to bottom, rgb(15 38 56 / 0.45), transparent 22%);
  }

  .content {
    position: relative;
    display: grid;
    gap: 1.5rem;
    padding-block: 8rem clamp(2rem, 5vw, 3.5rem);
  }
  .sub {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.45;
    animation: fade 700ms 450ms ease both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: fade 700ms 600ms ease both;
  }

  .pause {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1.5px solid rgb(255 255 255 / 0.6);
    border-radius: var(--pill);
    background: rgb(15 38 56 / 0.35);
    color: #fff;
    cursor: pointer;
  }
  .pause:hover {
    background: rgb(15 38 56 / 0.6);
  }

  /* Season switch, top right under the header */
  .season {
    position: absolute;
    top: calc(4.25rem + 1rem);
    right: var(--gutter);
    display: inline-flex;
    padding: 0.25rem;
    border: 1.5px solid rgb(255 255 255 / 0.6);
    border-radius: var(--pill);
    background: rgb(15 38 56 / 0.35);
    backdrop-filter: blur(6px);
  }
  .season button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0.4rem 1rem;
    border: 0;
    border-radius: var(--pill);
    background: transparent;
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 180ms ease;
  }
  .season button:hover {
    background: rgb(255 255 255 / 0.15);
  }
  .season button[aria-pressed='true'] {
    background: var(--signal);
    color: var(--on-signal);
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Phones in portrait: video in a square box at the top instead of a narrow full-height crop */
  @media (max-width: 900px) and (orientation: portrait) {
    .media,
    .scrim {
      inset: 0 0 auto;
      height: 100vw;
    }
    .scrim {
      background:
        linear-gradient(to bottom, rgb(15 38 56 / 0.5), transparent 22%),
        linear-gradient(to top, var(--ink) 0%, rgb(15 38 56 / 0.55) 30%, transparent 60%);
    }
    /* Text starts just below the video instead of leaving a gap on tall phones */
    .hero {
      min-height: auto;
    }
    .content {
      padding-top: calc(100vw - 3rem);
    }
  }

  @media (max-width: 640px) {
    .pause {
      top: 5rem;
      bottom: auto;
    }
    /* Next to the pause button */
    .season {
      top: 5rem;
      right: calc(var(--gutter) + 2.75rem + 0.5rem);
      padding: 0.15rem;
    }
    .season button {
      min-height: 2.25rem;
      padding: 0.3rem 0.8rem;
    }
  }
</style>
