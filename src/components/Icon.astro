---
// Phosphor icons (regular weight), inlined at build time. Decorative by default.
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'icon' } = Astro.props;
const icons = import.meta.glob<string>('/node_modules/@phosphor-icons/core/assets/regular/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const svg = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
if (!svg) throw new Error(`Icon "${name}" not found`);
const html = svg.replace('<svg', `<svg class="${className}" aria-hidden="true" focusable="false"`);
---

<Fragment set:html={html} />
