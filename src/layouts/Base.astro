---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../config';
import { photo } from '../data/photos';
import { ui, switchPath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  /** Header starts transparent over a full-bleed hero */
  overlayHeader?: boolean;
}
const { lang, title, overlayHeader = false } = Astro.props;
const t = ui[lang];
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${t.hero.kicker}`;
const og = await getImage({ src: photo('freeride-sonne'), width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = new URL(switchPath(lang, Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'de' ? 'en' : 'de'} href={other} />
    <link rel="icon" href={url('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta name="theme-color" content="#0f2638" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: site.name,
        description: t.description,
        url: Astro.site,
        email: site.email,
        ...(site.phone && { telephone: site.phone }),
        sameAs: site.instagram ? [site.instagram] : undefined,
        founder: { '@type': 'Person', name: site.person, jobTitle: t.role },
        areaServed: 'Schweizer Alpen',
      })}
    />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--signal);
    color: var(--on-signal);
    font-weight: 600;
    transform: translateY(-200%);
  }
  .skip:focus {
    transform: none;
  }
</style>
