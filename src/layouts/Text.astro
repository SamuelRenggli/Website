---
import Base from './Base.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
}
const { lang, title } = Astro.props;
---

<Base lang={lang} title={title}>
  <article class="wrap section text">
    <h1>{title}</h1>
    <slot />
  </article>
</Base>

<style>
  .text {
    max-width: 48rem;
  }
  h1 {
    margin-bottom: 2rem;
    font-size: var(--step-3);
  }
  .text :global(h2) {
    margin: 2.5rem 0 0.75rem;
    font-size: var(--step-1);
  }
  .text :global(p),
  .text :global(ul) {
    margin-bottom: 1rem;
  }
</style>
