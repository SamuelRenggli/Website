---
import Text from '../layouts/Text.astro';
import { ui, localePath } from '../i18n';
const t = ui.de.notFound;
const en = ui.en.notFound;
---

<Text lang="de" title={t.title}>
  <p>{t.text}</p>
  <p lang="en">{en.text}</p>
  <p><a class="btn btn-primary" href={localePath('de')}>{t.home}</a></p>
</Text>
